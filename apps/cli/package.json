{
    "name": "pagesieve-cli",
    "version": "0.3.0",
    "description": "A secondary client for extracting data based on the PageSieve ScrapeConfig. Provides Playwright and Cheerio based crawlers.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/julius383/PageSieve.git"
    },
    "homepage": "https://julius383.github.io/PageSieve/",
    "bugs": "https://github.com/julius383/PageSieve/issues",
    "keywords": ["cli", "scraping"],
    "type": "module",
    "bin": {
        "pagesieve": "./dist/index.js"
    },
    "files": ["dist", "README.md"],
    "scripts": {
        "build": "vite build && chmod +x ./dist/index.js",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@json2csv/plainjs": "catalog:",
        "@logtape/logtape": "catalog:",
        "es-toolkit": "catalog:",
        "nanoid": "catalog:",
        "ts-pattern": "catalog:",
        "xstate": "catalog:",
        "yaml": "catalog:",
        "zod": "catalog:",
        "cheerio": "^1.2.0",
        "commander": "^15.0.0",
        "fflate": "^0.8.3",
        "ofetch": "^1.5.1",
        "playwright": "^1.63.0",
        "undici": "^8.11."
    },
    "devDependencies": {
        "@pagesieve/core": "workspace:*",
        "@types/node": "^22.20.3",
        "vite": "catalog:"
    }
}
