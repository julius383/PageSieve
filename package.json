{
    "name": "pagesieve-monorepo",
    "version": "2.0.0",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "description": "PageSieve is a browser extension that assists with the extraction of structured data from any webpage you visit. Define field names, CSS selectors and (optionally) pagination strategy through a sidebar and extract and export data in a variety of formats.",
    "license": "MIT",
    "author": "Julius Kibunjia",
    "type": "module",
    "scripts": {
        "build": "bun run build:extension && bun run build:cli",
        "build:extension": "bun run --filter @pagesieve/extension build",
        "build:cli": "bun run --filter @pagesieve/cli build",
        "build:crawler": "bun run --filter @pagesieve/cli build",
        "lint": "eslint packages/",
        "format": "bunx prettier packages/ --write"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/compat": "^1.4.1",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@eslint/json": "^0.13.2",
        "@internationalized/date": "^3.12.3",
        "@lucide/svelte": "^0.561.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/table-core": "^8.21.3",
        "@types/bun": "^1.4.0",
        "@types/firefox-webext-browser": "^120.0.5",
        "@types/localforage": "^0.0.33",
        "@types/node": "^22.20.1",
        "@yoichiro/vite-plugin-handlebars": "^1.4.0",
        "autoprefixer": "^10.5.4",
        "bits-ui": "^2.19.0",
        "es-toolkit": "^1.52.0",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.23.0",
        "eta": "^4.6.0",
        "globals": "^16.5.0",
        "handlebars": "^4.7.9",
        "nanoid": "^5.1.16",
        "paneforge": "^1.0.2",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^3.5.2",
        "rollup-plugin-visualizer": "^7.1.1",
        "svelte": "^5.57.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript-eslint": "^8.68.0",
        "vite": "^7.3.6",
        "zod": "^4.5.4"
    }
}
