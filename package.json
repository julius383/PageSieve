{
    "name": "pagesieve",
    "version": "1.4.0",
    "description": "PageSieve is a browser extension that assists with the extraction of structured data from any webpage you visit. Define field names, CSS selectors and (optionally) pagination strategy through a sidebar and extract and export data in a variety of formats.",
    "license": "MIT",
    "author": "Julius Kibunjia",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "build": "bun run build:main && bun run build:content",
        "build:main": "BUILD_TARGET=main    vite build",
        "build:content": "BUILD_TARGET=content vite build",
        "lint": "eslint src/",
        "format": "bunx prettier src/ --write"
    },
    "dependencies": {
        "@json2csv/plainjs": "^7.0.6",
        "@kaifronsdal/svelte-json-viewer": "^0.1.0",
        "@logtape/logtape": "^2.1.1",
        "@medv/finder": "^4.0.2",
        "@svelteuidev/composables": "^0.15.7",
        "@svelteuidev/core": "^0.15.7",
        "client-zip": "^2.5.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.20",
        "es-toolkit": "^1.47.0",
        "localforage": "^1.10.0",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.1",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@eslint/json": "^0.13.2",
        "@internationalized/date": "^3.12.1",
        "@lucide/svelte": "^0.561.0",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/postcss": "^4.3.0",
        "@tanstack/table-core": "^8.21.3",
        "@types/bun": "^1.3.14",
        "@types/firefox-webext-browser": "^120.0.5",
        "@types/localforage": "^0.0.33",
        "@types/node": "^22.19.19",
        "@yoichiro/vite-plugin-handlebars": "^1.4.0",
        "autoprefixer": "^10.5.0",
        "bits-ui": "^2.18.1",
        "eslint": "^9.39.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.17.1",
        "eta": "^4.6.0",
        "globals": "^16.5.0",
        "handlebars": "^4.7.9",
        "paneforge": "^1.0.2",
        "postcss": "^8.5.15",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.2",
        "rollup-plugin-visualizer": "^7.0.1",
        "svelte": "^5.55.9",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript-eslint": "^8.59.4",
        "vite": "^7.3.3",
        "xstate": "^5.31.1"
    }
}
