{
    "name": "pagesieve-monorepo",
    "version": "2.0.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "description": "PageSieve is a browser extension that assists with the extraction of structured data from any webpage you visit. Define field names, CSS selectors and (optionally) pagination strategy through a sidebar and extract and export data in a variety of formats.",
    "license": "MIT",
    "author": "Julius Kibunjia",
    "type": "module",
    "scripts": {
        "build": "bun run build:extension && bun run build:cli",
        "build:extension": "bun run --filter @pagesieve/extension build",
        "build:cli": "bun run --filter @pagesieve/cli build",
        "build:crawler": "bun run --filter @pagesieve/cli build",
        "lint": "eslint packages/ apps/",
        "format": "bunx prettier packages/ apps/ --write"
    },
    "dependencies": {
        "ts-pattern": "^5.9.0",
        "xstate": "^5.33.2"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.47.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/table-core": "^8.21.3",
        "@types/bun": "^1.4.2",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/localforage": "^0.0.34",
        "@types/node": "^22.20.3",
        "@yoichiro/vite-plugin-handlebars": "^1.4.0",
        "autoprefixer": "^10.6.1",
        "bits-ui": "^2.19.2",
        "es-toolkit": "^1.52.0",
        "eslint": "^10.10.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.23.0",
        "eta": "^4.6.0",
        "globals": "^16.5.0",
        "handlebars": "^4.7.9",
        "nanoid": "^6.0.1",
        "paneforge": "^1.0.2",
        "postcss": "^8.5.28",
        "prettier": "^3.9.7",
        "prettier-plugin-svelte": "^3.5.2",
        "rollup-plugin-visualizer": "^7.1.1",
        "svelte": "^5.57.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "zod": "^4.6.5"
    }
}
